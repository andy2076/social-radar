# 既存
ADMIN_PASSWORD=

# --- 候補者SNS監視 ---
# Supabase（未設定なら data/monitor-db.json のローカルモックDBを使う）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 収集方法: 既定はログイン済みブラウザで X の画面から読む（手元のPCのみ。管理画面の「Xにログイン」を先に）
# X_SOURCE=mock                 # ダミー投稿で試すとき
# X_SCRAPE_SCROLLS=15           # 1検索あたりのスクロール回数
# X_REFRESH_HOURS=48            # この時間内の投稿は毎回いいね・表示回数を取り直す
# X_OWN_REPLY_POSTS=10          # リプライを集める本人投稿の数（新しい順）
# X_SCRAPE_HEADLESS=1           # ウィンドウを出さずに動かす（X に拒否されることがある）
# X API を使う場合のみ（有料）。設定するとブラウザ収集より優先
X_BEARER_TOKEN=
# X_QUERY_MAX_LENGTH=512        # Pro プランは 1024
# X_MAX_RESULTS_PER_RUN=100     # 1クエリ1回あたりの取得上限（課金対策）

# 収集間隔（分）。/api/cron/monitor をこれより短い間隔で呼んでもスキップする
MONITOR_INTERVAL_MINUTES=15
# /api/cron/monitor の認証（Authorization: Bearer <CRON_SECRET>）
CRON_SECRET=

# Claude API（分類）
ANTHROPIC_API_KEY=
# ワークスペースに紐付いていないキーを使う場合のみ（Console のワークスペース設定に表示される ID）
ANTHROPIC_WORKSPACE_ID=
# CLASSIFY_MODEL=claude-haiku-5-5   # 精度を上げたいときは claude-opus-5-5（費用は数倍）
# CLASSIFY_EFFORT=medium
# CLASSIFY_BATCH_SIZE=20        # 1サイクルで分類する最大件数
# CLASSIFY_CONCURRENCY=4
# MOCK_CLASSIFIER=1             # ローカルモックDB使用時のみ有効。Claude を呼ばずキーワードで仮分類

# 通知（監視対象ごとの設定が空のときのフォールバック先）
LINE_CHANNEL_ACCESS_TOKEN=
ALERT_LINE_TO=
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# 通知メッセージに載せるダッシュボードURLのベース
APP_BASE_URL=
